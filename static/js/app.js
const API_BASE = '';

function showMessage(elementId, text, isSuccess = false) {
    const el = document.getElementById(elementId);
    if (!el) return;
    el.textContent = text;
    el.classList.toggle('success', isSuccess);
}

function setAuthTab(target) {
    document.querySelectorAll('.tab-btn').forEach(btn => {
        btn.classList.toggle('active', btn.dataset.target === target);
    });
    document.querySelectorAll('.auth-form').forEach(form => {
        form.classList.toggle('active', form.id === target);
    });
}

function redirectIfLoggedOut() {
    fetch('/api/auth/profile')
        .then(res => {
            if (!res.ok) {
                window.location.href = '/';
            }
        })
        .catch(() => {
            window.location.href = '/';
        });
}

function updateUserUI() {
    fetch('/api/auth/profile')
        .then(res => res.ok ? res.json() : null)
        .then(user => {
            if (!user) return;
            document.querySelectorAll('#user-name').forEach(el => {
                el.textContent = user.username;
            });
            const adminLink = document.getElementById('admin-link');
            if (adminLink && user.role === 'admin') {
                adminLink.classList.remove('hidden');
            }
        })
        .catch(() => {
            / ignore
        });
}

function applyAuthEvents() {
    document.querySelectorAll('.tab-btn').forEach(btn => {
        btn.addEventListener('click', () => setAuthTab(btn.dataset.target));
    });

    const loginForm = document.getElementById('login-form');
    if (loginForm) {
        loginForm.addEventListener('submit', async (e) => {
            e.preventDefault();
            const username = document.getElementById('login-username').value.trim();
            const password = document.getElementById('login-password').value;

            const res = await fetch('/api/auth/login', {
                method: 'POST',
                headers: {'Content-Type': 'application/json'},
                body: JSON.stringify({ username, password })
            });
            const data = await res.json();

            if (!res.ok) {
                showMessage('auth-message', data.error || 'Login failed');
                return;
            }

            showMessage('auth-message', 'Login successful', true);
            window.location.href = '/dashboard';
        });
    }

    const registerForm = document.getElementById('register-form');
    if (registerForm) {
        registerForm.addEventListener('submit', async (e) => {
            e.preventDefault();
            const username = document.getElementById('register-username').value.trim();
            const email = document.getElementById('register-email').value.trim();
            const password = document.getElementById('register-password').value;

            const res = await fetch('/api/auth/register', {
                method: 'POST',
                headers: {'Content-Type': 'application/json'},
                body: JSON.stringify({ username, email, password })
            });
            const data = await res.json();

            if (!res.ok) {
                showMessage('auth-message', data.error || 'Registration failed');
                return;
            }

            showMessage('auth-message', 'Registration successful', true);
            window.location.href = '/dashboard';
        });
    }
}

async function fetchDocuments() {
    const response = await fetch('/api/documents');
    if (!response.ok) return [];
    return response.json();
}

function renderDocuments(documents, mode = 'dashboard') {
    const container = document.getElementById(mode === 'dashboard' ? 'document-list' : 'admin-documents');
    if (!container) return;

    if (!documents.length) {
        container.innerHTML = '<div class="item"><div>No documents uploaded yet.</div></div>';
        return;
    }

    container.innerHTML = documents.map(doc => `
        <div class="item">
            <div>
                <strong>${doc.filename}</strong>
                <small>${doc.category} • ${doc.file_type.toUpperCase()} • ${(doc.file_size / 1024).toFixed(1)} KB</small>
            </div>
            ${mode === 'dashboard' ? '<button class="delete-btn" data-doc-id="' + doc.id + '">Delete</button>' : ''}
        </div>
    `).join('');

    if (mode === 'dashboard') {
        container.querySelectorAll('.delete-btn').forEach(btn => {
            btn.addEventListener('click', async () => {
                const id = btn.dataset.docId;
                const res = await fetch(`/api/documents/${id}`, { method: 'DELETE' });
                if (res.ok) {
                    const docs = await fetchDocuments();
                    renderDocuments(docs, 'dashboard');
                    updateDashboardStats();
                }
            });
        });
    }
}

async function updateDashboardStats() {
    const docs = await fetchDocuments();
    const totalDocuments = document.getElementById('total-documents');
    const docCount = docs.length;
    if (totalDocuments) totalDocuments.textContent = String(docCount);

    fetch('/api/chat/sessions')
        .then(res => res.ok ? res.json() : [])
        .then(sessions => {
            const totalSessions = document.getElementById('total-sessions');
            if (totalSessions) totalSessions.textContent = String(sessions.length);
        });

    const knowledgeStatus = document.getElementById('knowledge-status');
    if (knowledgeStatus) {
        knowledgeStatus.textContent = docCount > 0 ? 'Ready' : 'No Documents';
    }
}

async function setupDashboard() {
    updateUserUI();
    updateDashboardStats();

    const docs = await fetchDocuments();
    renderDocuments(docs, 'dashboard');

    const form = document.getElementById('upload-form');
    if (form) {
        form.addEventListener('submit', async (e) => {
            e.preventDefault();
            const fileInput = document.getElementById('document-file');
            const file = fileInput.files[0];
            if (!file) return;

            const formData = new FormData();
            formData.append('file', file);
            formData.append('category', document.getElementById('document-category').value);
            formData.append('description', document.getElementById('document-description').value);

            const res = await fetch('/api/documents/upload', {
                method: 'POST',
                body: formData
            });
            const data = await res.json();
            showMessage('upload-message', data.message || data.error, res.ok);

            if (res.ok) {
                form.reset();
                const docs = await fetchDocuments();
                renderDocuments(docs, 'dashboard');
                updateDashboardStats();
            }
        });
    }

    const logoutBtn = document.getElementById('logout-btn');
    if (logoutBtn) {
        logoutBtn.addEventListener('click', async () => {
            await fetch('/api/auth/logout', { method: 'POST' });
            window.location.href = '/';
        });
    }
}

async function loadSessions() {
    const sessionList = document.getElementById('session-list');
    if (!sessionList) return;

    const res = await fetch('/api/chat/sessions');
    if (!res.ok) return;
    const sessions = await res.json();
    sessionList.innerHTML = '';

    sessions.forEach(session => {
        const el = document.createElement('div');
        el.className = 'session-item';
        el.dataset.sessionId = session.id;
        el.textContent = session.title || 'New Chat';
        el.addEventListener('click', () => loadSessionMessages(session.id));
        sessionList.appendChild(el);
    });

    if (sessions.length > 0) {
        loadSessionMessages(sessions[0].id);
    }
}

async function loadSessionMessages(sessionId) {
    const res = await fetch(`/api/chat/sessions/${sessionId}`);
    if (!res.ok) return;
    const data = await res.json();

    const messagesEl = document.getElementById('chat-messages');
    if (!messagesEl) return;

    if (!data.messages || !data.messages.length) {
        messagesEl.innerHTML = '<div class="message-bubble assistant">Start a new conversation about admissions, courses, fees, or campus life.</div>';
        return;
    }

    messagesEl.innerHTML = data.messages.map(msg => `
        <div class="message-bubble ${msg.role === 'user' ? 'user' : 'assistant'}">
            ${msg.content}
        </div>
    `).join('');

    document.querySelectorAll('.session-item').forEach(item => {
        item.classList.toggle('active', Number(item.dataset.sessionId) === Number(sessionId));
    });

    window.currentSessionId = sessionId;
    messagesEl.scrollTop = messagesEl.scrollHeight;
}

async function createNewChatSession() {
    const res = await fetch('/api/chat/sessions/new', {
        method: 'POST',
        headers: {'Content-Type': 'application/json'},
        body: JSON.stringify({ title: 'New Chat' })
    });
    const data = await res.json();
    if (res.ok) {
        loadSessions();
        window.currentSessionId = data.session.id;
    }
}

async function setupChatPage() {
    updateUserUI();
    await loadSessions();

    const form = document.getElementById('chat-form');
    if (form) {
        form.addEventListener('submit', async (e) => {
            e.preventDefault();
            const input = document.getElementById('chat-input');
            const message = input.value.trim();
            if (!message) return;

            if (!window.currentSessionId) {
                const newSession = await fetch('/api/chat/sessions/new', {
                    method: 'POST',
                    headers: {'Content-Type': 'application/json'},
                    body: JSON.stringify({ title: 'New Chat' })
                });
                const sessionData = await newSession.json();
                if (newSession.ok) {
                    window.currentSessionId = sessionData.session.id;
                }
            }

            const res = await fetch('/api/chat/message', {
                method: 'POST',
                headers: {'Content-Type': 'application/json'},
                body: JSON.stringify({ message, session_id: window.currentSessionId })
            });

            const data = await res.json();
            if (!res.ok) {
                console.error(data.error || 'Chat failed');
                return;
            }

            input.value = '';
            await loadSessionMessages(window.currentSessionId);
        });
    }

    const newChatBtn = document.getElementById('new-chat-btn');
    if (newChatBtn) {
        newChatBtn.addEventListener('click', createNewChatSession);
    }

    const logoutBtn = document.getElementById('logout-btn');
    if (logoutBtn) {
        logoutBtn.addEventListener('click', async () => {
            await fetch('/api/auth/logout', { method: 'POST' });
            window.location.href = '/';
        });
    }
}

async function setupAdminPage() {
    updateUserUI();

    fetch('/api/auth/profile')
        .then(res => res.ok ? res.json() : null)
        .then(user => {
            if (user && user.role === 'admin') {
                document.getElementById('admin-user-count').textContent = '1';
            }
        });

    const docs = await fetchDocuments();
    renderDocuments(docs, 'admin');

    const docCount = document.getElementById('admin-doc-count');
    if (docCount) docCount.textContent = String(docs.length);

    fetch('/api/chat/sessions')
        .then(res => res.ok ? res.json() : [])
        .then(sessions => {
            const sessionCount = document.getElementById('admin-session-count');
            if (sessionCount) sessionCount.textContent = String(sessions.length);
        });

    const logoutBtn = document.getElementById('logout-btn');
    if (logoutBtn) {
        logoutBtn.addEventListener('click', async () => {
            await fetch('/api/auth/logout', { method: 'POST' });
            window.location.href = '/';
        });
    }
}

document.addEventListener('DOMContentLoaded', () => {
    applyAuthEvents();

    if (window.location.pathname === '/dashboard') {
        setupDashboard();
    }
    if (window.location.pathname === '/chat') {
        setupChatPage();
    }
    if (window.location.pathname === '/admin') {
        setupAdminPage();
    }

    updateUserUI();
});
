* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f3f6fb;
    color: #1b2430;
}

button, input, textarea, select {
    font: inherit;
}

.auth-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #0f172a, #1d4ed8);
}

.container {
    width: min(100%, 480px);
    padding: 24px;
}

.card {
    background: #fff;
    padding: 30px;
    border-radius: 16px;
    box-shadow: 0 20px 60px rgba(15, 23, 42, 0.2);
}

.brand {
    text-align: center;
    margin-bottom: 24px;
}

.brand h1 {
    margin: 0 0 8px;
    color: #0f172a;
}

.brand p {
    margin: 0;
    color: #475569;
}

.tab-buttons {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
}

.tab-btn {
    flex: 1;
    border: 1px solid #cbd5e1;
    background: #f8fafc;
    color: #334155;
    padding: 10px 14px;
    border-radius: 8px;
    cursor: pointer;
}

.tab-btn.active {
    background: #2563eb;
    border-color: #2563eb;
    color: white;
}

.auth-form {
    display: none;
}

.auth-form.active {
    display: block;
}

.form-group {
    margin-bottom: 18px;
}

.form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
}

.form-group input,
textarea,
select {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background: #fff;
}

textarea {
    min-height: 80px;
    resize: vertical;
}

.primary-btn,
.secondary-btn {
    border: none;
    border-radius: 8px;
    padding: 12px 18px;
    cursor: pointer;
    font-weight: 600;
}

.primary-btn {
    background: #2563eb;
    color: #fff;
    width: 100%;
}

.secondary-btn {
    background: #e2e8f0;
    color: #1e293b;
}

.message {
    margin-top: 16px;
    min-height: 22px;
    color: #dc2626;
    font-size: 0.95rem;
}

.message.success {
    color: #15803d;
}

.app-shell {
    display: flex;
    min-height: 100vh;
}

.sidebar {
    width: 260px;
    background: #0f172a;
    color: white;
    padding: 20px 18px;
}

.sidebar-header {
    margin-bottom: 24px;
}

.sidebar-header h2 {
    margin: 0 0 8px;
}

.nav-link {
    display: block;
    margin-bottom: 10px;
    padding: 12px 14px;
    border-radius: 8px;
    color: #e2e8f0;
    text-decoration: none;
    background: rgba(255,255,255,0.04);
}

.nav-link.active {
    background: rgba(59,130,246,0.25);
}

.main-content {
    flex: 1;
    padding: 24px;
}

.topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
    margin-bottom: 24px;
}

.stat-card,
.panel {
    background: white;
    border-radius: 12px;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.06);
    padding: 20px;
}

.stat-card h3,
.panel h2 {
    margin-top: 0;
}

.stat-card p {
    font-size: 1.8rem;
    font-weight: 700;
    margin: 10px 0 0;
}

.upload-panel {
    margin-bottom: 24px;
}

.form-row {
    display: flex;
    gap: 12px;
    margin-bottom: 16px;
}

.form-row input,
.form-row select {
    flex: 1;
}

.item-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 12px 14px;
    background: #f8fafc;
}

.item small {
    display: block;
    color: #64748b;
    margin-top: 5px;
}

.delete-btn {
    border: none;
    background: #fee2e2;
    color: #b91c1c;
    padding: 8px 12px;
    border-radius: 8px;
    cursor: pointer;
}

.chat-layout {
    display: flex;
    flex-direction: column;
}

.chat-window {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 20px;
    height: calc(100vh - 180px);
}

.session-panel,
.chat-panel {
    background: white;
    border-radius: 12px;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.06);
    padding: 14px;
}

.session-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 12px;
}

.session-item {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 10px 12px;
    cursor: pointer;
}

.session-item.active {
    background: #dbeafe;
    border-color: #93c5fd;
}

.chat-panel {
    display: flex;
    flex-direction: column;
}

.chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 12px;
    background: #f8fafc;
    border-radius: 10px;
    margin-bottom: 12px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.message-bubble {
    max-width: 85%;
    padding: 12px 14px;
    border-radius: 12px;
    line-height: 1.5;
    white-space: pre-wrap;
}

.message-bubble.user {
    align-self: flex-end;
    background: #2563eb;
    color: white;
}

.message-bubble.assistant {
    align-self: flex-start;
    background: white;
    border: 1px solid #e2e8f0;
}

.chat-form {
    display: flex;
    gap: 10px;
}

.chat-form input {
    flex: 1;
    padding: 12px 14px;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
}

.hidden {
    display: none !important;
}

@media (max-width: 900px) {
    .app-shell {
        flex-direction: column;
    }

    .sidebar {
        width: 100%;
    }

    .chat-window {
        grid-template-columns: 1fr;
    }
}
